# ─────────────────────────────────────────────────────────────────────────────
# GrowthOS — environment. Everything is optional for the DEMO: with nothing set,
# the demo runs end to end and every payment is labelled SIMULATED.
# All secrets are server-side only. Never prefix them with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Required in production (≥ 32 chars). In dev a random one is generated under .data/
SESSION_SECRET=

# Database: leave empty for embedded Postgres (PGlite, stored in .data/pglite).
# DATABASE_URL=postgres://user:pass@localhost:5432/growthos

# ── Agent wallet (pick ONE) ──────────────────────────────────────────────────
# A) Circle developer-controlled wallet (recommended — keys stay in Circle custody)
#    npm run wallet:setup -- --entity-secret   (once), then npm run wallet:setup
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
# B) Server-side testnet key (organizer example model). TESTNET ONLY.
#    npm run wallet:setup -- --local
AGENT_PRIVATE_KEY=
GROWTHOS_NETWORK=testnet

# ── x402 seller bundled in services/signals-api (port 4021) ─────────────────
# The Arc Testnet address that receives payments for the bundled data service.
SIGNALS_SELLER_ADDRESS=
SIGNALS_API_URL=http://localhost:4021
# Optional: where demo creator payouts go (else SIGNALS_SELLER_ADDRESS, else a burn address).
DEMO_PAYOUT_ADDRESS=

# ── Circle endpoints (defaults shown) ───────────────────────────────────────
# GATEWAY_API_URL=https://gateway-api-testnet.circle.com
# CIRCLE_DISCOVERY_URL=https://api.circle.com/v2/x402/discovery/resources
# ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# ── Optional: Arc Onramp ("Add budget") ─────────────────────────────────────
ONRAMP_API_KEY=

# ── Optional: Claude for product reading + creator drafts (heuristics otherwise)
ANTHROPIC_API_KEY=
# GROWTHOS_CLAUDE_MODEL=claude-opus-5-5

# ── Market data providers (official APIs only) ──────────────────────────────
GITHUB_TOKEN=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:growthos:0.1 (by /u/yourname)
YOUTUBE_API_KEY=
# Comma-separated RSS/Atom feeds for news & blogs
RSS_FEEDS=

# ── Scheduled operator (POST /api/cron/cycle with Authorization: Bearer …) ──
CRON_SECRET=
